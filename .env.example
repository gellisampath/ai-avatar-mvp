# Provider: mock | openai | anthropic
VITE_MODEL_PROVIDER=mock

# OpenAI-compatible (OpenAI, Azure OpenAI, Groq, local OpenAI-compat servers, etc.)
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
