# Provider: mock | openai | anthropic
VITE_MODEL_PROVIDER=anthropic

# OpenAI-compatible (OpenAI, Azure OpenAI, Groq, local OpenAI-compat servers, etc.)
VITE_OPENAI_API_KEY=
VITE_OPENAI_BASE_URL=https://api.openai.com/v1
VITE_OPENAI_MODEL=gpt-4o-mini

# Anthropic — preferred local setup: server-side key + Vite proxy (key not baked into the browser bundle)
ANTHROPIC_API_KEY=
VITE_ANTHROPIC_BASE_URL=/anthropic
VITE_ANTHROPIC_MODEL=claude-haiku-4-5-20251001
VITE_ANTHROPIC_VERSION=2023-06-01

# Optional direct browser calls (exposes the key in the client bundle — avoid for shared deploys)
# VITE_ANTHROPIC_API_KEY=
# VITE_ANTHROPIC_BASE_URL=https://api.anthropic.com
